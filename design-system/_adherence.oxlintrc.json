{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "assets/**",
              "components/controls/**",
              "components/data/**",
              "components/feedback/**",
              "components/forms/**",
              "components/identity/**",
              "components/navigation/**",
              "components/overlay/**",
              "components/shell/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Cascadia Code))/i]",
        "message": "Font not provided by the design system. Available: Cascadia Code."
      },
      {
        "selector": "JSXOpeningElement[name.name='AppShell'] > JSXAttribute > JSXIdentifier[name!=/^(?:topbar|status|key|ref|className|style|children)$/]",
        "message": "<AppShell> doesn't accept that prop. Declared props: topbar, status."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: type."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|kbd|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, kbd."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|soft|default|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'soft' | 'default' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:lg|md|sm|xs)$/]",
        "message": "<Button> size must be one of 'lg' | 'md' | 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Crumbs'] > JSXAttribute > JSXIdentifier[name!=/^(?:items|onNavigate|key|ref|className|style|children)$/]",
        "message": "<Crumbs> doesn't accept that prop. Declared props: items, onNavigate."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|num|mono|render|key|ref|className|style|children)$/]",
        "message": "<GridColumn> doesn't accept that prop. Declared props: key, label, num, mono, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='Dialog'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|title|context|actions|onClose|key|ref|className|style|children)$/]",
        "message": "<Dialog> doesn't accept that prop. Declared props: open, title, context, actions, onClose."
      },
      {
        "selector": "JSXOpeningElement[name.name='Field'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|hint|invalid|key|ref|className|style|children)$/]",
        "message": "<Field> doesn't accept that prop. Declared props: label, value, hint, invalid."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='ListRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:lead|name|meta|tools|on|muted|key|ref|className|style|children)$/]",
        "message": "<ListRow> doesn't accept that prop. Declared props: lead, name, meta, tools, on, muted."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute > JSXIdentifier[name!=/^(?:letter|grid|size|key|ref|className|style|children)$/]",
        "message": "<Mark> doesn't accept that prop. Declared props: letter, grid, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='letter'] > Literal[value!=/^(?:D|S|I|Q)$/]",
        "message": "<Mark> letter must be one of 'D' | 'S' | 'I' | 'Q'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Mark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:md|lg)$/]",
        "message": "<Mark> size must be one of 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='NodeRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:node|calledOut|key|ref|className|style|children)$/]",
        "message": "<NodeRow> doesn't accept that prop. Declared props: node, calledOut."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|actions|key|ref|className|style|children)$/]",
        "message": "<Notice> doesn't accept that prop. Declared props: tone, icon, actions."
      },
      {
        "selector": "JSXOpeningElement[name.name='Notice'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|info|ok|warn|err)$/]",
        "message": "<Notice> tone must be one of 'default' | 'info' | 'ok' | 'warn' | 'err'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ResizeRail'] > JSXAttribute > JSXIdentifier[name!=/^(?:horizontal|dragging|tip|label|key|ref|className|style|children)$/]",
        "message": "<ResizeRail> doesn't accept that prop. Declared props: horizontal, dragging, tip, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Segmented'] > JSXAttribute > JSXIdentifier[name!=/^(?:options|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Segmented> doesn't accept that prop. Declared props: options, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Slider'] > JSXAttribute > JSXIdentifier[name!=/^(?:min|max|step|value|key|ref|className|style|children)$/]",
        "message": "<Slider> doesn't accept that prop. Declared props: min, max, step, value."
      },
      {
        "selector": "JSXOpeningElement[name.name='State'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|key|ref|className|style|children)$/]",
        "message": "<State> doesn't accept that prop. Declared props: tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='State'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:empty|loading|err)$/]",
        "message": "<State> tone must be one of 'empty' | 'loading' | 'err'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Swatches'] > JSXAttribute > JSXIdentifier[name!=/^(?:colors|value|onChange|key|ref|className|style|children)$/]",
        "message": "<Swatches> doesn't accept that prop. Declared props: colors, value, onChange."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tabs'] > JSXAttribute > JSXIdentifier[name!=/^(?:tabs|value|onChange|underline|key|ref|className|style|children)$/]",
        "message": "<Tabs> doesn't accept that prop. Declared props: tabs, value, onChange, underline."
      },
      {
        "selector": "JSXOpeningElement[name.name='TipHost'] > JSXAttribute > JSXIdentifier[name!=/^(?:tip|below|key|ref|className|style|children)$/]",
        "message": "<TipHost> doesn't accept that prop. Declared props: tip, below."
      },
      {
        "selector": "JSXOpeningElement[name.name='Toggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|checked|disabled|onChange|className|key|ref|className|style|children)$/]",
        "message": "<Toggle> doesn't accept that prop. Declared props: label, checked, disabled, onChange, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Tree'] > JSXAttribute > JSXIdentifier[name!=/^(?:data|key|ref|className|style|children)$/]",
        "message": "<Tree> doesn't accept that prop. Declared props: data."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
